# URL of the marchesdirect-backend Express API (no trailing slash, no /api suffix).
VITE_API_URL=http://localhost:5000

# Optional: YouTube/Vimeo link or direct .mp4 URL for the "Voir la démo — 40 sec"
# button on the homepage. Left unset shows an honest "coming soon" state instead
# of a broken or fake player - no code change needed once a real video exists.
VITE_DEMO_VIDEO_URL=
