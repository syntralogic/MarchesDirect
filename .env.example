# URL of the marchesdirect-backend Express API (no trailing slash, no /api suffix).
VITE_API_URL=http://localhost:5000

# Optional: YouTube/Vimeo link or direct .mp4 URL for the "Voir la démo — 40 sec"
# button on the homepage. Left unset shows an honest "coming soon" state instead
# of a broken or fake player - no code change needed once a real video exists.
VITE_DEMO_VIDEO_URL=

# Google Sign-In (Google Cloud Console > Credentials > OAuth client ID, type "Web application")
VITE_GOOGLE_CLIENT_ID=

# HubSpot tracking (optional). Portal ID = HubSpot > Settings > Tracking & analytics > Tracking code
# (the number in the script URL). Region: eu1 for app-eu1.hubspot.com, na1 for app.hubspot.com.
# Leave empty to disable. The CRM sync itself is server-side (HUBSPOT_ACCESS_TOKEN on the backend).
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_REGION=eu1
