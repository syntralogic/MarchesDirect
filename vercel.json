{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/prerender?kind=home"
    },
    {
      "source": "/sitemap-:part.xml",
      "destination": "/api/sitemap.xml?part=:part"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/:base(marches-publics|appels-doffres|sous-traitance)",
      "destination": "/api/prerender?kind=category&base=:base"
    },
    {
      "source": "/:base(marches-publics|appels-doffres|sous-traitance)/departement/:department/:trade",
      "destination": "/api/prerender?kind=local&base=:base&department=:department&trade=:trade"
    },
    {
      "source": "/:base(marches-publics|appels-doffres|sous-traitance)/departement/:department",
      "destination": "/api/prerender?kind=local&base=:base&department=:department"
    },
    {
      "source": "/:base(marches-publics|appels-doffres|sous-traitance)/:city/:trade",
      "destination": "/api/prerender?kind=local&base=:base&city=:city&trade=:trade"
    },
    {
      "source": "/:base(marches-publics|appels-doffres|sous-traitance)/:city",
      "destination": "/api/prerender?kind=local&base=:base&city=:city"
    },
    {
      "source": "/opportunites/:id",
      "destination": "/api/prerender?kind=opportunity&id=:id"
    },
    {
      "source": "/pages/:slug",
      "destination": "/api/prerender?kind=slug&slug=:slug"
    },
    {
      "source": "/guides",
      "destination": "/api/prerender?kind=guides"
    },
    {
      "source": "/guides/:slug",
      "destination": "/api/prerender?kind=guide&slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/actualites",
      "destination": "/guides",
      "statusCode": 301
    },
    {
      "source": "/actualites/a1",
      "destination": "/guides/dc1-dc2-dume",
      "statusCode": 301
    },
    {
      "source": "/actualites/a2",
      "destination": "/guides",
      "statusCode": 301
    },
    {
      "source": "/actualites/a3",
      "destination": "/marches-publics",
      "statusCode": 301
    },
    {
      "source": "/actualites/a4",
      "destination": "/guides/dc1-dc2-dume",
      "statusCode": 301
    },
    {
      "source": "/actualites/a5",
      "destination": "/guides/memoire-technique",
      "statusCode": 301
    },
    {
      "source": "/actualites/a6",
      "destination": "/guides",
      "statusCode": 301
    },
    {
      "source": "/actualites/:id",
      "destination": "/guides",
      "statusCode": 301
    }
  ]
}
